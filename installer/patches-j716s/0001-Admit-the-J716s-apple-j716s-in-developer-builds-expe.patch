+    def _j716s(self):
+        installer, files = fixture()
+        installer.sysinfo.device_class = 'j716sap'
+        installer.sysinfo.board_id = 0x0C
+        installer.sysinfo.dt = {'target-type': b'J716s\0'}
+        installer.identity['ApBoardID'] = '0x0C'
+        installer.identity['Info']['DeviceClass'] = 'j716sap'
+        prefix = 'Firmware/Manifests/restore/macOS Customer/centauri/centauri.'
+        files[prefix + 'j716sap.im4m'] = files.pop(prefix + 'j714sap.im4m')
+        return installer, files
+
+    def test_j716s_tickets_its_own_identity(self):
+        installer, files = self._j716s()
+        name, output = c.prepare(installer)
+        self.assertEqual(name, 'apple/centauri/j716s-ftab.bin')
+        self.assertEqual(output[len(files['Firmware/ftab.bin']):],
+                         files['Firmware/Manifests/restore/macOS Customer/centauri/centauri.j716sap.im4m'])
+        self.assertEqual(set(installer.reads), set(files))
+
+    def test_j716s_with_another_board_id_rejects_before_firmware_reads(self):
+        for board in (0x08, 0x14):
+            installer, _ = self._j716s()
+            installer.sysinfo.board_id = board
+            with self.subTest(board=board), self.assertRaises(c.CentauriError):
+                c.prepare(installer)
+            self.assertEqual(installer.reads, [])
+
     def test_accessory_identity_is_independent_of_ap_board(self):
         for options in ({'board': 8}, {'chip': 0x6050}, {'personalized': True}, {'production': False}):
             with self.subTest(options=options), self.assertRaises(c.CentauriError):
