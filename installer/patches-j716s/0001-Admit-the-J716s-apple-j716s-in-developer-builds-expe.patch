+# T6050 boards whose N1 (Centauri) FTAB is ticketed from the selected restore
+# identity, by device class and board ID. EXPERIMENTAL J716s: its 26B123
+# macOS Customer identity names the same FTAB (t2026macG1, Wireless1 chip
+# 0x2026, board 2113) and the same digests as the J714s's.
+CENTAURI_BOARDS = {"j714sap": 0x08, "j716sap": 0x0C}
+
+
 def prepare(installer):
     """Return normal FWPackage (name, bytes), or None for a legacy board.
 
@@ -225,13 +232,14 @@ def prepare(installer):
     use that StubInstaller's existing ZIP/cache, never another firmware URL.
